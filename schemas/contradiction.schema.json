{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/contradiction.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ctr-"
    },
    "left": {
      "type": "string",
      "minLength": 1
    },
    "right": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "queued",
        "resolved",
        "dismissed"
      ]
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "resolution_notes": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "left",
    "right",
    "reason",
    "status"
  ],
  "additionalProperties": false,
  "title": "Cristalina Contradiction"
}
