{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/projection-manifest.schema.json",
  "type": "object",
  "properties": {
    "projection_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "audience": {
      "type": "string",
      "enum": [
        "owner_private",
        "agent_operational",
        "project_private",
        "shareable",
        "public_safe"
      ]
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "writeback_mode": {
      "type": "string",
      "enum": [
        "none",
        "proposal_extraction",
        "deterministic_sync"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^drv-"
          },
          "artifact_type": {
            "type": "string",
            "enum": [
              "compiled_hot",
              "compiled_warm",
              "compiled_cold",
              "bootstrap_soul",
              "bootstrap_value",
              "bootstrap_user",
              "bootstrap_memory"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "intended_audience": {
            "type": "string",
            "enum": [
              "owner_private",
              "agent_operational",
              "project_private",
              "shareable",
              "public_safe"
            ]
          },
          "generated_by": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "const": "canonical_projection"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "projection_id": {
            "type": "string",
            "minLength": 1
          },
          "writeback_mode": {
            "type": "string",
            "enum": [
              "none",
              "proposal_extraction",
              "deterministic_sync"
            ]
          },
          "parsable": {
            "type": "boolean"
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "checksum": {
            "type": "string",
            "minLength": 1
          },
          "machine_extractable_sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "artifact_type",
          "created_at",
          "derived_from",
          "intended_audience",
          "generated_by",
          "source",
          "path",
          "projection_id",
          "writeback_mode",
          "parsable",
          "checksum"
        ],
        "additionalProperties": false
      }
    },
    "contract": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "writeback_mode": {
          "type": "string",
          "enum": [
            "none",
            "proposal_extraction",
            "deterministic_sync"
          ]
        },
        "default_source_type": {
          "type": "string",
          "const": "runtime_observation"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "artifact_type": {
                "type": "string",
                "enum": [
                  "compiled_hot",
                  "compiled_warm",
                  "compiled_cold",
                  "bootstrap_soul",
                  "bootstrap_value",
                  "bootstrap_user",
                  "bootstrap_memory"
                ]
              },
              "parsable": {
                "type": "boolean"
              },
              "machine_extractable_sections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "requires_human_review": {
                "type": "boolean"
              },
              "allowed_operations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "create",
                    "confirm",
                    "revise",
                    "supersede",
                    "deprecate",
                    "contradict"
                  ]
                }
              },
              "provenance_source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "artifact_type",
              "parsable",
              "machine_extractable_sections",
              "default_confidence",
              "requires_human_review",
              "allowed_operations",
              "provenance_source"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "adapter",
        "writeback_mode",
        "default_source_type",
        "files"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "projection_id",
    "adapter",
    "generated_at",
    "audience",
    "writeback_mode",
    "artifacts",
    "contract"
  ],
  "additionalProperties": false,
  "title": "Cristalina Projection Manifest"
}
