{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/event.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt-"
    },
    "kind": {
      "type": "string",
      "enum": [
        "heartbeat",
        "interaction",
        "observation",
        "inference",
        "runtime_drift",
        "contradiction_detected",
        "proposal_generated",
        "compilation",
        "validation_failure",
        "ratification_applied",
        "other"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "human_reply",
        "human_message",
        "agent_inference",
        "agent_synthesis",
        "runtime_observation",
        "external_source",
        "imported"
      ]
    },
    "privacy_scope": {
      "type": "string",
      "enum": [
        "owner_private",
        "agent_operational",
        "project_private",
        "shareable",
        "public_safe"
      ]
    },
    "actor": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "related_entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "details": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {}
        },
        {
          "type": "array",
          "items": {}
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "kind",
    "ts",
    "summary",
    "source_type",
    "privacy_scope"
  ],
  "additionalProperties": true,
  "title": "Cristalina Event"
}
