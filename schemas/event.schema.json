{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/event.schema.json",
  "title": "Cristalina Event",
  "type": "object",
  "required": [
    "id",
    "kind",
    "ts",
    "summary",
    "source_type",
    "privacy_scope"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "privacy_scope": {
      "type": "string",
      "enum": [
        "owner_private",
        "agent_operational",
        "project_private",
        "shareable",
        "public_safe"
      ]
    },
    "details": {
      "type": [
        "object",
        "array",
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
