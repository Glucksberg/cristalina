{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/manifest.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "memory_protocol"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "object",
      "properties": {
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "data_model": {
          "type": "string",
          "minLength": 1
        },
        "curation_protocol": {
          "type": "string",
          "minLength": 1
        },
        "openclaw_adapter": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "spec",
        "data_model",
        "curation_protocol",
        "openclaw_adapter"
      ],
      "additionalProperties": false
    },
    "schemas": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "proposal": {
          "type": "string",
          "minLength": 1
        },
        "memory_object": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "manifest",
        "event",
        "proposal",
        "memory_object"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string"
    },
    "repository_version": {
      "type": "string"
    },
    "canonical_language": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "release_notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "display_name",
    "type",
    "protocol_version",
    "documents",
    "schemas"
  ],
  "additionalProperties": false,
  "title": "Cristalina Manifest"
}
