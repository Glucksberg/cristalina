{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/relationship.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rel-"
    },
    "kind": {
      "type": "string",
      "const": "relationship"
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "from_ref": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^ent-"
        },
        "object_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^fact-"
            },
            {
              "type": "string",
              "pattern": "^rel-"
            },
            {
              "type": "string",
              "pattern": "^val-"
            },
            {
              "type": "string",
              "pattern": "^idt-"
            },
            {
              "type": "string",
              "pattern": "^sty-"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "owner",
            "agent",
            "project",
            "runtime",
            "channel",
            "person",
            "organization",
            "fact",
            "preference",
            "constraint",
            "relationship",
            "belief",
            "identity_trait",
            "style_rule",
            "value",
            "priority"
          ]
        },
        "facet": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "string",
      "enum": [
        "prefers",
        "works_on",
        "trusts",
        "avoids",
        "owns",
        "depends_on",
        "contradicts",
        "supersedes",
        "belongs_to",
        "cares_about"
      ]
    },
    "to": {
      "type": "string",
      "minLength": 1
    },
    "to_ref": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^ent-"
        },
        "object_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^fact-"
            },
            {
              "type": "string",
              "pattern": "^rel-"
            },
            {
              "type": "string",
              "pattern": "^val-"
            },
            {
              "type": "string",
              "pattern": "^idt-"
            },
            {
              "type": "string",
              "pattern": "^sty-"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "owner",
            "agent",
            "project",
            "runtime",
            "channel",
            "person",
            "organization",
            "fact",
            "preference",
            "constraint",
            "relationship",
            "belief",
            "identity_trait",
            "style_rule",
            "value",
            "priority"
          ]
        },
        "facet": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "ratified",
        "crystallized",
        "deprecated",
        "archived",
        "disputed"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "human_reply",
        "human_message",
        "agent_inference",
        "agent_synthesis",
        "runtime_observation",
        "external_source",
        "imported"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "privacy_scope": {
      "type": "string",
      "enum": [
        "owner_private",
        "agent_operational",
        "project_private",
        "shareable",
        "public_safe"
      ]
    },
    "valid_from": {
      "type": "string"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_confirmed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "kind",
    "relation",
    "status",
    "confidence",
    "source_type",
    "source_ref",
    "privacy_scope"
  ],
  "additionalProperties": false,
  "title": "Cristalina Relationship"
}
