{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/derived-artifact.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^drv-"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "compiled_hot",
        "compiled_warm",
        "compiled_cold",
        "bootstrap_soul",
        "bootstrap_value",
        "bootstrap_user",
        "bootstrap_memory"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intended_audience": {
      "type": "string",
      "enum": [
        "owner_private",
        "agent_operational",
        "project_private",
        "shareable",
        "public_safe"
      ]
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "const": "canonical_projection"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "projection_id": {
      "type": "string",
      "minLength": 1
    },
    "writeback_mode": {
      "type": "string",
      "enum": [
        "none",
        "proposal_extraction",
        "deterministic_sync"
      ]
    },
    "parsable": {
      "type": "boolean"
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "checksum": {
      "type": "string",
      "minLength": 1
    },
    "machine_extractable_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "artifact_type",
    "created_at",
    "derived_from",
    "intended_audience",
    "generated_by",
    "source",
    "path",
    "projection_id",
    "writeback_mode",
    "parsable",
    "checksum"
  ],
  "additionalProperties": false,
  "title": "Cristalina Derived Artifact"
}
