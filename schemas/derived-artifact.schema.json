{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/derived-artifact.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^drv-"
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intended_audience": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "artifact_type",
    "created_at",
    "derived_from",
    "intended_audience"
  ],
  "additionalProperties": false,
  "title": "Cristalina Derived Artifact"
}
