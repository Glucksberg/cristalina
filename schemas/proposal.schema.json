{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/proposal.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^prop-"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_fact",
        "revise_fact",
        "revise_preference",
        "new_value",
        "revise_value",
        "identity_adjustment",
        "privacy_change",
        "supersede_memory",
        "deprecate_memory",
        "open_contradiction"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "create",
        "confirm",
        "revise",
        "supersede",
        "deprecate",
        "contradict"
      ]
    },
    "target_ref": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^(evt-|prop-|fact-|rel-|val-|idt-|sty-|ctr-|drv-|q-(?!r)|qr-|dcp-)"
        },
        "kind": {
          "type": "string",
          "enum": [
            "fact",
            "preference",
            "constraint",
            "project",
            "relationship",
            "belief",
            "identity_trait",
            "style_rule",
            "value",
            "priority"
          ]
        },
        "facet": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        { "required": ["object_id"] },
        { "required": ["kind"] },
        { "required": ["facet"] }
      ]
    },
    "candidate_payload": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "fact",
            "preference",
            "constraint",
            "project",
            "relationship",
            "belief",
            "identity_trait",
            "style_rule",
            "value",
            "priority"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "privacy_scope": {
          "type": "string",
          "enum": [
            "owner_private",
            "agent_operational",
            "project_private",
            "shareable",
            "public_safe"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related_entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related_object_id": {
          "type": "string",
          "pattern": "^(evt-|prop-|fact-|rel-|val-|idt-|sty-|ctr-|drv-|q-(?!r)|qr-|dcp-)"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "supporting_events": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evt-"
          }
        }
      },
      "required": [
        "supporting_events"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "queued_for_curation",
        "approved",
        "rejected",
        "deferred",
        "applied",
        "expired"
      ]
    },
    "privacy_scope": {
      "type": "string",
      "enum": [
        "owner_private",
        "agent_operational",
        "project_private",
        "shareable",
        "public_safe"
      ]
    },
    "policy_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "requires_human_approval": {
          "type": "boolean"
        }
      },
      "required": [
        "level",
        "requires_human_approval"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "operation",
    "target_ref",
    "candidate_payload",
    "reason",
    "provenance",
    "confidence",
    "status",
    "privacy_scope"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": ["confirm", "revise", "supersede", "deprecate", "contradict"]
          }
        }
      },
      "then": {
        "properties": {
          "target_ref": {
            "required": ["object_id"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": ["create", "revise", "supersede"]
          }
        }
      },
      "then": {
        "properties": {
          "candidate_payload": {
            "required": ["kind", "statement"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "contradict"
          }
        }
      },
      "then": {
        "properties": {
          "candidate_payload": {
            "required": ["kind", "related_object_id"]
          }
        }
      }
    }
  ],
  "title": "Cristalina Proposal"
}
