{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/proposal.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^prop-"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_fact",
        "revise_fact",
        "revise_preference",
        "new_value",
        "revise_value",
        "identity_adjustment",
        "privacy_change",
        "supersede_memory",
        "deprecate_memory",
        "open_contradiction"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "supporting_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "queued_for_curation",
        "approved",
        "rejected",
        "deferred",
        "applied",
        "expired"
      ]
    },
    "privacy_scope": {
      "type": "string",
      "enum": [
        "owner_private",
        "agent_operational",
        "project_private",
        "shareable",
        "public_safe"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "impact_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "requires_human_approval": {
      "type": "boolean"
    },
    "question_candidate": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "target",
    "reason",
    "supporting_events",
    "confidence",
    "status",
    "privacy_scope"
  ],
  "additionalProperties": false,
  "title": "Cristalina Proposal"
}
