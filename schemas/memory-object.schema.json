{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/memory-object.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "fact",
        "preference",
        "constraint",
        "project",
        "relationship",
        "belief",
        "identity_trait",
        "style_rule",
        "value",
        "priority"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "ratified",
        "crystallized",
        "deprecated",
        "archived",
        "disputed"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "human_reply",
        "human_message",
        "agent_inference",
        "agent_synthesis",
        "runtime_observation",
        "external_source",
        "imported"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_confirmed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "privacy_scope": {
      "type": "string",
      "enum": [
        "owner_private",
        "agent_operational",
        "project_private",
        "shareable",
        "public_safe"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valid_from": {
      "type": "string"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_entities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ent-"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "statement",
    "status",
    "confidence",
    "source_type",
    "source_ref",
    "created_at",
    "last_confirmed_at",
    "confirmed_by",
    "evidence_count",
    "privacy_scope"
  ],
  "additionalProperties": false,
  "title": "Cristalina Canonical Memory Object"
}
