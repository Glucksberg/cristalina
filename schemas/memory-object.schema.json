{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cristalina.dev/schemas/memory-object.schema.json",
  "title": "Cristalina Canonical Memory Object",
  "type": "object",
  "required": [
    "id",
    "kind",
    "statement",
    "status",
    "confidence",
    "created_at",
    "source_type",
    "source_ref",
    "privacy_scope"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "ratified",
        "crystallized",
        "deprecated",
        "archived",
        "disputed"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_confirmed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_type": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "privacy_scope": {
      "type": "string",
      "enum": [
        "owner_private",
        "agent_operational",
        "project_private",
        "shareable",
        "public_safe"
      ]
    },
    "confirmed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
